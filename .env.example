# Copy this file to ".env" (same folder) and fill in your real key.
# Never commit the real ".env" file to git — it's already listed in .gitignore.

ANTHROPIC_API_KEY=your-

# Neon Postgres connection string (Dashboard -> your project -> Connection
# Details -> "Connection string", the one that starts postgres://). Optional:
# if this is left blank, the app falls back to the local SQLite file
# (data/app.db) automatically — see core/db.py.
DATABASE_URL=

# Signs the per-browser session cookie (app.storage.user — login + tenant
# selection). REQUIRED for any real deployment: set a long random value. If
# unset the app uses an obvious dev-only default (see app_nicegui.ui.run).
IRCONNECT_STORAGE_SECRET=

# ── Auth bootstrap (see core/auth.py) ──────────────────────────────────────
# First Praxis Point staff (admin) login, seeded ONLY on first boot when no
# staff user exists yet. It is forced to change its password on first sign-in,
# so treat this as a one-time bootstrap credential and rotate it immediately.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Default password stamped onto the two standard client_user logins seeded for
# every tenant ("directorofir@<ticker>" and "irassistant@<ticker>"). Both are
# forced to change it on first sign-in. Rotate the value here before seeding a
# new tenant; fallback if unset is "IRconnect01".
DEFAULT_USER_PASSWORD=

# Anymail Finder — resolves the EMAIL for a contact whose name/title/phone we already pulled from
# EDGAR (core/email_finder.py). Platform-level: one Praxis Point account serves every tenant, so a
# person is resolved once and reused. Get the key at newapp.anymailfinder.com -> Settings -> API
# ("Get API Key"). Only `valid` results cost a credit; risky/not_found/blacklisted are free, and a
# repeat search for the same person within 30 days is free. Leave blank to disable enrichment.
ANYMAILFINDER_API_KEY=

# ── Lighthouse verdict digest (lighthouse/digest.py) ───────────────────────
# Pushes the daily Lighthouse verdict to a phone (email now, SMS-capable). OFF by default and
# fail-closed: with no recipients / not enabled, the scheduler renders but never sends. Turn it on
# ONLY once you have consented recipients.
LIGHTHOUSE_DIGEST_ENABLED=            # 1/true to actually send
LIGHTHOUSE_DIGEST_TO=                 # comma-separated email recipients
LIGHTHOUSE_DIGEST_SMS_TO=             # comma-separated E.164 phone numbers (needs TWILIO_* below)
LIGHTHOUSE_DIGEST_EMAIL_TIER=informational   # min tier to email: monitoring|informational|important|critical
LIGHTHOUSE_DIGEST_SMS_TIER=important         # min tier to SMS (keep higher so phones only buzz on real moves)
LIGHTHOUSE_APP_URL=                   # e.g. https://praxis-iq.onrender.com — deep-links the "open full read" CTA
# Engagement tracking (email opens + click-throughs + in-app views) is automatic once digests send and
# LIGHTHOUSE_APP_URL is set — the open-pixel/CTA hit /lh/o and /lh/c, signed by IRCONNECT_STORAGE_SECRET.
# It answers "is Lighthouse used or ignored" (readout on the Lighthouse page). Set OFF only for test runs.
LIGHTHOUSE_TELEMETRY_OFF=             # 1 to suppress engagement writes (tests/smoke set this automatically)
# Outbound mail (reuses the existing GoDaddy pattern; from_email defaults to the SMTP user)
LIGHTHOUSE_SMTP_HOST=smtpout.secureserver.net
LIGHTHOUSE_SMTP_PORT=465
LIGHTHOUSE_SMTP_USER=                 # e.g. irconnect@usio.com
LIGHTHOUSE_SMTP_PASSWORD=
LIGHTHOUSE_FROM_EMAIL=
# Optional SMS via Twilio (only used when LIGHTHOUSE_DIGEST_SMS_TO is set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
